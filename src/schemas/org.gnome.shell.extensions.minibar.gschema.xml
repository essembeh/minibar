<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.minibar" path="/org/gnome/shell/extensions/minibar/">
    <key name="size" type="s">
      <choices>
        <choice value="normal"/>
        <choice value="large"/>
        <choice value="extra-large"/>
      </choices>
      <default>'normal'</default>
      <summary>Bar size</summary>
      <description>Top bar and icon size, kept proportional.</description>
    </key>
    <key name="spacing" type="s">
      <choices>
        <choice value="small"/>
        <choice value="normal"/>
        <choice value="large"/>
      </choices>
      <default>'normal'</default>
      <summary>Icon spacing</summary>
      <description>Distance between the taskbar icons.</description>
    </key>
    <key name="bar-position" type="s">
      <choices>
        <choice value="top"/>
        <choice value="bottom"/>
      </choices>
      <default>'top'</default>
      <summary>Bar position</summary>
      <description>Move the whole GNOME panel to the top or bottom of the screen.</description>
    </key>
    <key name="clock-position" type="s">
      <choices>
        <choice value="center"/>
        <choice value="right"/>
      </choices>
      <default>'center'</default>
      <summary>Clock position</summary>
      <description>Show the clock in the center or on the right of the panel.</description>
    </key>
    <key name="isolate-workspaces" type="b">
      <default>false</default>
      <summary>Workspace isolation</summary>
      <description>Only count and show windows from the current workspace.</description>
    </key>
    <key name="notification-badges" type="b">
      <default>true</default>
      <summary>Notification badges</summary>
      <description>Show a badge with the unread notification count on app icons.</description>
    </key>
    <key name="scroll-workspace" type="b">
      <default>true</default>
      <summary>Scroll to change workspace</summary>
      <description>Scrolling on the top bar switches workspace (no wrap-around).</description>
    </key>
  </schema>
</schemalist>
